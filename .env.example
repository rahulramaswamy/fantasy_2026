# Copy to .env and fill in. Nothing here is secret for read-only Sleeper use.
# Your Sleeper username -- the one you log in with, NOT your team's display
# name. This is all you need; everything else can be discovered from it.
SLEEPER_USERNAME=
# Optional. Your numeric Sleeper user_id, if you happen to know it. Leave blank
# and it is resolved from the username above. (Putting a username here works
# too -- it is resolved the same way.)
SLEEPER_USER_ID=
# The league you are playing in this season.
SLEEPER_LEAGUE_ID=
# The draft you are drafting in (found via `ff sleeper drafts`).
SLEEPER_DRAFT_ID=
# Where cached data lives.
FF_DATA_DIR=./data
# Optional: path to a local clone of dynastyprocess/data (its files/ dir),
# so expert rankings work without network access on draft day.
FF_DP_LOCAL_DIR=
